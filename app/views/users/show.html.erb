<h1>User #<%= @user.id %></h1>

<% if notice.present? %>
  <p style="color: green;"><%= notice %></p>
<% end %>

<p>
  <strong>Name:</strong>
  <%= @user.name %>
</p>

<p>
  <strong>Email:</strong>
  <%= @user.email %>
</p>

<p>
  <%= link_to "Edit", edit_user_path(@user) %>
  |
  <%= link_to "Back to users", users_path %>
</p>

